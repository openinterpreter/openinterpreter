{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadGoalStatus": {
      "enum": [
        "active",
        "paused",
        "blocked",
        "usageLimited",
        "budgetLimited",
        "complete"
      ],
      "type": "string"
    }
  },
  "properties": {
    "expectedGoalId": {
      "description": "All four expected fields are required together for an atomic Goal CAS when an existing Goal is being changed. Objective and token-budget edits are included in the same transaction; mission_revision advances for those edits and lifecycle_revision advances for every successful mutation. Omit all four only when the authoritative read found no Goal and this request is creating the first Goal.",
      "type": [
        "string",
        "null"
      ]
    },
    "expectedLifecycleRevision": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "expectedMissionRevision": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "expectedStatus": {
      "anyOf": [
        {
          "$ref": "#/definitions/ThreadGoalStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/definitions/ThreadGoalStatus"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    },
    "tokenBudget": {
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "threadId"
  ],
  "title": "ThreadGoalSetParams",
  "type": "object"
}